# Database (async for app, sync URL derived for Alembic)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sensbridge_panns

# Model storage (download on first run if missing)
MODEL_DIR=./models
GLOBAL_THRESHOLD=0.85

# Optional
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
