# MongoDB
MONGODB_URI=mongodb://localhost:27017/sensebridge
MONGO_URL=mongodb://localhost:27017/sensebridge

# JWT
JWT_SECRET=your-secret-key

# Email — obligatoire pour l'email d'acceptation (admin accepte un utilisateur app)
# Sans MAIL_HOST et MAIL_USER, l'utilisateur est bien accepté mais ne reçoit pas d'email.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=SenseBridge <noreply@sensebridge.com>

# Server
PORT=4004
